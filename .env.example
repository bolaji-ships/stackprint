# stackprint configuration. Copy to ~/.config/stackprint/.env (CLI) or set in your host's env (server).
# Names only. Never commit real values.

# Where the SQLite index lives (default: ~/.local/share/stackprint/stackprint.db for the CLI)
DB_PATH=

# Server
HOST=127.0.0.1
PORT=8787
# JSON array: [{"name":"me","key":"<long random string>","scopes":["lookup","deep","fresh","index"]}]
STACKPRINT_API_KEYS=
RATE_LIMIT_SCANS_PER_MIN=60
MAX_CONCURRENT_SCANS=4
CACHE_MAX_AGE_DAYS=7

# Deep mode (headless Chromium). Requires `npx playwright install chromium`.
DEEP_ENABLED=true

# Optional residential proxy, used only to retry after a bot wall. Never logged.
PROXY_URL=

# AGPL network clause: where users of your instance can get the source
SOURCE_URL=https://github.com/bolaji-ships/stackprint
